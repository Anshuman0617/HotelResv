DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/hotel_booking
JWT_SECRET_KEY=<REPLACE_WITH_A_REAL_SECRET_AT_LEAST_32_CHARACTERS>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000

# --- Docker (docker-compose.yml) ---
# Inside compose, the backend reaches Postgres at host "db"; DATABASE_URL above
# is for running the backend directly on your machine.
POSTGRES_DB=hotel_booking
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST_PORT=5433
SEED_ON_START=true

# --- Scaling ---
# Worker processes, and the database pool each one opens. Keep
# WEB_CONCURRENCY x (DB_POOL_SIZE + DB_MAX_OVERFLOW) below Postgres's
# max_connections (100).
WEB_CONCURRENCY=4
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
