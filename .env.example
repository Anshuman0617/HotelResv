DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/hotel_booking
JWT_SECRET_KEY=change-this-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000
GOOGLE_CLIENT_ID=

# --- Docker (docker-compose.yml) ---
# Inside compose, the backend reaches Postgres at host "db"; DATABASE_URL above
# is for running the backend directly on your machine.
POSTGRES_DB=hotel_booking
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST_PORT=5433
SEED_ON_START=true
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
